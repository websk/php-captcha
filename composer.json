{
  "name": "websk/php-captcha",
  "description": "Captcha generator and Slim route handlers",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*",
    "ext-gd": "*",
    "ext-session": "*",
    "slim/slim": "^4.15",
    "websk/php-slim": "2.4.*",
    "websk/php-utils": "3.0.*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "WebSK\\": "src/WebSK/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WebSK\\Captcha\\Tests\\": "tests/"
    }
  },
  "archive": {
    "exclude": [
      "/.ai",
      "/.idea",
      "/.phpstan-cache",
      "/.phpunit.cache",
      "/vendor",
      "/*.zip"
    ]
  },
  "scripts": {
    "lint": "find src public tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "php -d error_reporting=E_ALL vendor/bin/phpunit",
    "phpstan": "php -d error_reporting=E_ALL vendor/bin/phpstan analyse --no-progress --debug",
    "check": [
      "@lint",
      "@test",
      "@phpstan"
    ]
  }
}
